# Optional. These power the WhatsApp / email alert only.
#
# Enquiries are recorded in the Google Sheet by the browser itself, so the form
# works with none of this set — you simply do not get notified.
# Copy to .env.local for local use, and set the same values in your host's
# environment settings (Vercel / Netlify dashboard) for production.

# --- WhatsApp (Meta Cloud API) ---------------------------------------------
# Business-initiated messages need an approved template, so set
# WHATSAPP_TEMPLATE once yours is approved. Its body must take 4 variables:
# {{1}} name, {{2}} location, {{3}} project type, {{4}} email.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=15125550184
WHATSAPP_TEMPLATE=

# --- Email notification (Resend) -------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL=studio@cdbarchitecture.com
NOTIFY_FROM=CDB Website <website@cdbarchitecture.com>
